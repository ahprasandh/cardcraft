{
  "id": "brutalist",
  "name": "Brutalist",
  "description": "Heavy color blocks, oversized type and high-contrast — avant-garde and aggressive.",
  "card": {
    "width": 350,
    "height": 200
  },
  "background": "palette.backgroundAlt",
  "elements": [
    {
      "id": "block",
      "type": "shape",
      "shape": "rect",
      "x": 0,
      "y": 0,
      "width": 210,
      "height": 90,
      "fill": "palette.accent"
    },
    {
      "id": "name",
      "type": "text",
      "x": 20,
      "y": 22,
      "source": "cardInfo.name",
      "fontSize": 30,
      "fontWeight": "bold",
      "fontFamily": "design.font",
      "letterSpacing": -0.5,
      "textTransform": "uppercase",
      "color": "palette.onAlt"
    },
    {
      "id": "title",
      "type": "text",
      "x": 20,
      "y": 124,
      "source": "cardInfo.title",
      "fontSize": "body",
      "fontWeight": "bold",
      "fontFamily": "design.font",
      "letterSpacing": 1.6,
      "textTransform": "uppercase",
      "color": "palette.accent"
    },
    {
      "id": "company",
      "type": "text",
      "x": 20,
      "y": 140,
      "source": "cardInfo.company",
      "fontSize": "caption",
      "fontWeight": "medium",
      "fontFamily": "design.font",
      "color": "palette.onAlt"
    },
    {
      "id": "tagline",
      "type": "text",
      "x": 20,
      "y": 152,
      "source": "cardInfo.tagline",
      "fontSize": "caption",
      "fontStyle": "italic",
      "fontFamily": "design.font",
      "color": "palette.onAlt",
      "hideIfEmpty": true
    },
    {
      "id": "email",
      "type": "text",
      "x": 20,
      "y": 166,
      "source": "cardInfo.email",
      "fontSize": "caption",
      "fontFamily": "design.font",
      "color": "palette.onAlt"
    },
    {
      "id": "phone",
      "type": "text",
      "x": 20,
      "y": 178,
      "source": "cardInfo.phone",
      "fontSize": "caption",
      "fontFamily": "design.font",
      "color": "palette.onAlt"
    }
  ]
}