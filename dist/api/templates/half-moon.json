{
  "id": "half-moon",
  "name": "Half Moon",
  "description": "A large semicircle bleeds off the left edge. Content on the right. Geometric and calm.",
  "card": {
    "width": 350,
    "height": 200
  },
  "background": "palette.background",
  "elements": [
    {
      "id": "moon",
      "type": "shape",
      "shape": "circle",
      "x": -80,
      "y": 20,
      "radius": 80,
      "fill": "palette.backgroundAlt"
    },
    {
      "id": "name",
      "type": "text",
      "x": 110,
      "y": 30,
      "source": "cardInfo.name",
      "fontSize": "heading",
      "fontWeight": "bold",
      "fontFamily": "design.font",
      "letterSpacing": -0.3,
      "color": "palette.primary"
    },
    {
      "id": "title",
      "type": "text",
      "x": 110,
      "y": 54,
      "source": "cardInfo.title",
      "fontSize": "body",
      "fontFamily": "design.font",
      "color": "palette.text"
    },
    {
      "id": "company",
      "type": "text",
      "x": 110,
      "y": 70,
      "source": "cardInfo.company",
      "fontSize": "caption",
      "fontWeight": "semibold",
      "fontFamily": "design.font",
      "letterSpacing": 1,
      "textTransform": "uppercase",
      "color": "palette.secondary"
    },
    {
      "id": "divider",
      "type": "shape",
      "shape": "rect",
      "x": 110,
      "y": 100,
      "width": 24,
      "height": 1,
      "fill": "palette.accent"
    },
    {
      "id": "email",
      "type": "text",
      "x": 110,
      "y": 114,
      "source": "cardInfo.email",
      "fontSize": "caption",
      "fontFamily": "design.font",
      "color": "palette.text"
    },
    {
      "id": "phone",
      "type": "text",
      "x": 110,
      "y": 128,
      "source": "cardInfo.phone",
      "fontSize": "caption",
      "fontFamily": "design.font",
      "color": "palette.text",
      "hideIfEmpty": true
    },
    {
      "id": "website",
      "type": "text",
      "x": 110,
      "y": 142,
      "source": "cardInfo.website",
      "fontSize": "caption",
      "fontWeight": "semibold",
      "fontFamily": "design.font",
      "color": "palette.primary",
      "hideIfEmpty": true
    }
