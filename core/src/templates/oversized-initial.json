{
  "id": "oversized-initial",
  "name": "Oversized Initial",
  "description": "A massive faded letter fills the background. Content sits on top. Statement piece.",
  "card": {
    "width": 350,
    "height": 200
  },
  "background": "palette.background",
  "elements": [
    {
      "id": "big-letter",
      "type": "text",
      "x": 220,
      "y": -20,
      "source": "cardInfo.name",
      "fontSize": 160,
      "fontWeight": "bold",
      "fontFamily": "design.font",
      "color": "palette.accent",
      "opacity": 0.08,
      "firstChar": true
    },
    {
      "id": "company",
      "type": "text",
      "x": 24,
      "y": 20,
      "source": "cardInfo.company",
      "fontSize": "caption",
      "fontWeight": "bold",
      "fontFamily": "design.font",
      "letterSpacing": 1.5,
      "textTransform": "uppercase",
      "color": "palette.secondary"
    },
    {
      "id": "name",
      "type": "text",
      "x": 24,
      "y": 48,
      "source": "cardInfo.name",
      "fontSize": "heading",
      "fontWeight": "bold",
      "fontFamily": "design.font",
      "letterSpacing": -0.3,
      "color": "palette.primary"
    },
    {
      "id": "title",
      "type": "text",
      "x": 24,
      "y": 72,
      "source": "cardInfo.title",
      "fontSize": "body",
      "fontFamily": "design.font",
      "color": "palette.text"
    },
    {
      "id": "divider",
      "type": "shape",
      "shape": "rect",
      "x": 24,
      "y": 100,
      "width": 24,
      "height": 1,
      "fill": "palette.accent"
    },
    {
      "id": "email",
      "type": "text",
      "x": 24,
      "y": 116,
      "source": "cardInfo.email",
      "fontSize": "caption",
      "fontFamily": "design.font",
      "color": "palette.text"
    },
    {
      "id": "phone",
      "type": "text",
      "x": 24,
      "y": 130,
      "source": "cardInfo.phone",
      "fontSize": "caption",
      "fontFamily": "design.font",
      "color": "palette.text",
      "hideIfEmpty": true
    },
    {
      "id": "website",
      "type": "text",
      "x": 24,
      "y": 144,
      "source": "cardInfo.website",
      "fontSize": "caption",
      "fontWeight": "semibold",
      "fontFamily": "design.font",
      "color": "palette.primary",
      "hideIfEmpty": true
    },
    {
      "id": "logo",
      "type": "image",
      "x": 290,
      "y": 12,
      "width": 60,
      "height": 24,
      "source": "cardInfo.customLogoUrl",
      "fit": "contain",
      "hideIfEmpty": true
    }
  ]
}
