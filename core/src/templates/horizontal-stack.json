{
  "id": "horizontal-stack",
  "name": "Horizontal Stack",
  "description": "Tight horizontal rows separated by full-width rules. Dense and utilitarian.",
  "card": {
    "width": 350,
    "height": 200
  },
  "background": "palette.background",
  "elements": [
    {
      "id": "rule1",
      "type": "shape",
      "shape": "line",
      "x": 0,
      "y": 44,
      "x2": 350,
      "y2": 44,
      "stroke": "palette.primary",
      "strokeWidth": 0.5
    },
    {
      "id": "rule2",
      "type": "shape",
      "shape": "line",
      "x": 0,
      "y": 90,
      "x2": 350,
      "y2": 90,
      "stroke": "palette.primary",
      "strokeWidth": 0.5
    },
    {
      "id": "rule3",
      "type": "shape",
      "shape": "line",
      "x": 0,
      "y": 136,
      "x2": 350,
      "y2": 136,
      "stroke": "palette.primary",
      "strokeWidth": 0.5
    },
    {
      "id": "name",
      "type": "text",
      "x": 16,
      "y": 12,
      "source": "cardInfo.name",
      "fontSize": 18,
      "fontWeight": "bold",
