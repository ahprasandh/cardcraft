{
  "name": "@cardcraft/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-free template + spec library for CardCraft. Renders card specs as data, with an optional experimental SVG preview renderer.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./templates/*": "./src/templates/*.json",
    "./manifest": "./src/manifest.ts",
    "./palettes": "./src/palettes.ts",
    "./typography": "./src/typography.ts"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "serve": "tsx scripts/serve.ts",
    "validate": "tsx scripts/validate.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
